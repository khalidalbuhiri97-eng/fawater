# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL (server-side only).
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Secret service_role key (NEVER expose to client/Vite).
SUPABASE_SERVICE_ROLE_KEY=""

# Browser-safe Supabase configuration (publishable/anon key only).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side JWT verification key. Use the anon/public key, never the service-role key.
SUPABASE_ANON_KEY=""
